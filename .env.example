# Neon Postgres (pooled connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Long random string used to sign session cookies (openssl rand -base64 48)
JWT_SECRET=
# S3-compatible object storage (Neon Object Storage)
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
# Optional: Google sign-in. Redirect URI: https://<your-domain>/_api/auth/oauth_callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_AUTH=false

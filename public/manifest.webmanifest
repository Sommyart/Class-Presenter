{
  "id": "/",
  "name": "ClassPresenter",
  "short_name": "ClassPresenter",
  "description": "Upload your slides, give each one a timer, and always know where you stand.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#16131F",
  "theme_color": "#7C5CE7",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My presentations", "url": "/presentations", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
